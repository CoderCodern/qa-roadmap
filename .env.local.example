# ─── Auth (NextAuth v5) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
# For local dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Database (Neon Postgres) ────────────────────────────────────────────────────
# Create a free project at https://neon.tech, then copy the connection string.
# After adding this, run: pnpm db:push   (applies schema to the DB)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── AI Hint (OpenAI) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Award Email (Resend) ───────────────────────────────────────────────────────
# 1. Sign up at https://resend.com (free tier: 100 emails/day)
# 2. Create an API key at https://resend.com/api-keys
# 3. Set ADMIN_EMAIL to the address that should receive award notifications
#
# From address notes:
#   - During development you can leave RESEND_FROM_EMAIL unset; it defaults to
#     onboarding@resend.dev, but Resend only allows sending to your own account
#     email in sandbox mode.
#   - For production, verify your domain at https://resend.com/domains and set
#     RESEND_FROM_EMAIL to something like: QA Roadmap <notify@yourdomain.com>

RESEND_API_KEY=re_...
ADMIN_EMAIL=your-admin@example.com
# RESEND_FROM_EMAIL=QA Roadmap <notify@yourdomain.com>
